# mldash — configuration
# Copy to .env and adjust values. All variables are optional — defaults work for standard Kubeflow.

# HTTP port (default: 8080)
PORT=8080

# Path to a kubeconfig file. Leave empty to use in-cluster configuration or
# the default local kubeconfig path.
KUBECONFIG=

# Kubeconfig context to use (default: current context)
# Useful when working with multiple clusters
KUBE_CONTEXT=

# Prefix for Kubeflow user namespaces (default: kubeflow-)
# Kubeflow creates user namespaces as <prefix><username>
# Examples: kubeflow-, kubeflow-user-
KUBEFLOW_NS_PREFIX=kubeflow-

# Extra namespaces with GPU workloads (non-notebook), comma-separated (default: empty)
# These are namespaces running GPU deployments outside of Kubeflow (e.g. LLM inference)
# Example: GPU_NAMESPACES=llm,inference,ml-serving
GPU_NAMESPACES=
